# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000

# ==========================================
# MODO DE ALMACENAMIENTO DE ARCHIVOS
# 'local'       -> Guarda archivos en el servidor en la carpeta uploads/ (100% local y offline)
# 'cloudinary'  -> Sube archivos a la cuenta de Cloudinary configurada
# ==========================================
STORAGE_TYPE=cloudinary
UPLOAD_DIR=uploads

# ==========================================
# MOTOR DE BASE DE DATOS
# 'sqlite' -> Base de datos local embebida sin necesidad de instalar servicios adicionales (Recomendado para uso local directo)
# 'mysql'  -> Conexión a MySQL/MariaDB local (XAMPP, WAMP, Docker, etc.)
# ==========================================
DB_CLIENT=mysql

# Configuración para SQLite (archivo local)
SQLITE_DB_PATH=./data/database.sqlite

# Configuración para MySQL en la Nube (Clever Cloud)
DB_HOST=b5qfkmkgbpptjrfprpkm-mysql.services.clever-cloud.com
DB_PORT=3306
DB_USER=ukzg9jlo9mrv26xv
DB_PASSWORD=0HgmBT6CJRze9jfD6LtI
DB_NAME=b5qfkmkgbpptjrfprpkm
DB_CONNECTION_LIMIT=3

