{
  "name": "document-upload-app",
  "version": "1.0.0",
  "description": "Aplicación para carga de documentos con MySQL y Cloudinary",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "open": "start http://localhost:3000",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js --target=local",
    "migrate:cloudinary": "node scripts/migrate.js --target=cloudinary",
    "generate-pdf": "node scripts/generate-analista-pdf.js",
    "generate-manual": "node generate-manual.js"
  },
  "dependencies": {
    "cloudinary": "^1.41.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "pdfkit": "^0.18.0"
  }
}
